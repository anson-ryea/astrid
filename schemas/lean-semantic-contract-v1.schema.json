{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Astrid private Lean semantic contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "paper_id",
    "protocol",
    "outputs",
    "reference_submission",
    "reference",
    "specification",
    "obligations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "enum": [
        "lean_definition",
        "lean_declaration",
        "lean_statement"
      ]
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^Benchmark\\.[A-Za-z][A-Za-z0-9_]*$"
          },
          "type": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reference_submission": {
      "$ref": "#/$defs/file"
    },
    "reference": {
      "$ref": "#/$defs/file"
    },
    "specification": {
      "$ref": "#/$defs/file"
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "compatibility": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_./-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "proof"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^AstridSpec\\.[a-z][a-z0-9_]*$"
        },
        "proof": {
          "$ref": "#/$defs/file"
        },
        "refutation": {
          "$ref": "#/$defs/file"
        }
      }
    }
  }
}
