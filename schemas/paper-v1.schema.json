{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:astrid:paper:v1",
  "title": "ASTRID paper registry V1",
  "description": "User-authored paper.json: paper identity, registered source results and optional bibliographic and provenance metadata.",
  "$comment": "The validator additionally checks that the paper identity matches each task and that each task's source_result_id is registered. Metadata is optional so synthetic registries need only schema_version, paper_id and results.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_id",
    "results"
  ],
  "properties": {
    "$schema": {
      "$ref": "#/$defs/nonBlankString",
      "description": "Optional editor schema reference; it does not affect execution."
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "paper_id": {
      "type": "string",
      "pattern": "^paper_[1-9][0-9]*$"
    },
    "title": {
      "$ref": "#/$defs/nonBlankString"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonBlankString"
      }
    },
    "venue": {
      "$ref": "#/$defs/nonBlankString"
    },
    "year": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "supplementary_source": {
      "$ref": "#/$defs/source"
    },
    "mechanisation_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "provisional"
      ],
      "properties": {
        "label": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Author-supplied assessment label, not an automatic eligibility verdict."
        },
        "provisional": {
          "type": "boolean"
        },
        "assessed_on": {
          "type": "string",
          "format": "date"
        },
        "scope": {
          "$ref": "#/$defs/nonBlankString"
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    }
  },
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonBlankString"
        },
        "edition": {
          "$ref": "#/$defs/nonBlankString"
        },
        "path": {
          "$ref": "#/$defs/nonBlankString"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "physical_page_count": {
          "type": "integer",
          "minimum": 1
        },
        "scope": {
          "$ref": "#/$defs/nonBlankString"
        },
        "local_copy": {
          "type": "boolean"
        }
      }
    }
  }
}
