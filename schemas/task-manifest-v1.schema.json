{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lara.dev/schemas/task-manifest-v1.schema.json",
  "title": "ASTRID task manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "paper_id",
    "source_result_id",
    "task_type",
    "protocol",
    "status",
    "condition",
    "context_id",
    "artefacts",
    "submission",
    "evaluation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^task_[1-9][0-9]*\\.[1-9][0-9]*_[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "paper_id": {
      "type": "string",
      "pattern": "^paper_[1-9][0-9]*$"
    },
    "source_result_id": {
      "$ref": "#/$defs/lowerSnakeCase"
    },
    "task_type": {
      "type": "integer",
      "minimum": 1
    },
    "protocol": {
      "$ref": "#/$defs/lowerSnakeCase"
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate_pending_independent_review",
        "frozen"
      ]
    },
    "condition": {
      "$ref": "#/$defs/lowerSnakeCase"
    },
    "context_id": {
      "$ref": "#/$defs/lowerSnakeCase"
    },
    "artefacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "path",
          "sha256"
        ],
        "properties": {
          "role": {
            "$ref": "#/$defs/lowerSnakeCase"
          },
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "allow_local_helpers",
        "allow_top_level_declarations"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/lowerSnakeCase"
        },
        "allow_local_helpers": {
          "type": "boolean"
        },
        "allow_top_level_declarations": {
          "type": "boolean"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "timeout",
        "allowed_axioms",
        "forbidden_mechanisms",
        "forbidden_identifiers"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/lowerSnakeCase"
        },
        "timeout": {
          "type": "string",
          "format": "duration",
          "description": "A finite, positive ISO-8601 duration, checked by the manifest reader."
        },
        "allowed_axioms": {
          "$ref": "#/$defs/nonBlankStringSet"
        },
        "forbidden_mechanisms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lowerSnakeCase"
          }
        },
        "forbidden_identifiers": {
          "$ref": "#/$defs/nonBlankStringSet"
        }
      }
    }
  },
  "$defs": {
    "lowerSnakeCase": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonBlankStringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
