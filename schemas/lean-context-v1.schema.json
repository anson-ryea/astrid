{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Astrid public Lean context V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "context_id", "paper_id", "imports", "files", "closure"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "context_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "paper_id": {"type": "string", "pattern": "^paper_[1-9][0-9]*$"},
    "imports": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^dataset\\.paper_[1-9][0-9]*\\.formalisation\\.[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)*$"}
    },
    "files": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^dataset/paper_[1-9][0-9]*/formalisation/(?:[A-Za-z0-9_]+/)*[A-Za-z0-9_]+\\.lean$"}
    },
    "closure": {
      "type": "object", "additionalProperties": false, "required": ["algorithm", "sha256"],
      "properties": {
        "algorithm": {"const": "sha256_length_prefixed_paths_and_contents_v1"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
